{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/kill-mt5-before-backtest.sh\"",
            "statusMessage": "回测前检查并关闭占用的 MT5..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/remind-gridtrader.sh\"",
            "statusMessage": "检查 GridTrader.mq5 修改闭环..."
          }
        ]
      }
    ]
  }
}
