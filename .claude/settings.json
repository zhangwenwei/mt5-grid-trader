{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "PowerShell|Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/kill-mt5-before-backtest.sh\"",
            "statusMessage": "Checking for and closing a running MT5 before the backtest..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/remind-gridtrader.sh\"",
            "statusMessage": "Checking the GridTrader.mq5 change loop..."
          }
        ]
      }
    ]
  }
}
